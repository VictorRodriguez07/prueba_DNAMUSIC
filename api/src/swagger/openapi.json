{
  "openapi": "3.0.0",
  "info": {
    "title": "dnaMusic ERP API",
    "version": "1.0.0",
    "description": "API backend para la gestion de sedes, estudiantes y estadisticas de la plataforma dnaMusic."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor de desarrollo local"
    },
    {
      "url": "https://prueba-dnamusic.onrender.com",
      "description": "Servidor de produccion en Render"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Ingresa el token JWT obtenido del login para autorizar las peticiones."
      }
    },
    "schemas": {
      "Role": {
        "type": "string",
        "enum": ["ADMIN", "OPERADOR"]
      },
      "EstadoSede": {
        "type": "string",
        "enum": ["ACTIVA", "INACTIVA"]
      },
      "EstadoEstudiante": {
        "type": "string",
        "enum": ["ACTIVO", "INACTIVO", "RETIRADO"]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "nombre": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "role": { "$ref": "#/components/schemas/Role" },
          "sedeId": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Sede": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "nombre": { "type": "string" },
          "ciudad": { "type": "string" },
          "direccion": { "type": "string" },
          "estado": { "$ref": "#/components/schemas/EstadoSede" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Estudiante": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "nombreCompleto": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "telefono": { "type": "string" },
          "documentoIdentidad": { "type": "string" },
          "sedeId": { "type": "string" },
          "programa": { "type": "string" },
          "estado": { "$ref": "#/components/schemas/EstadoEstudiante" },
          "fechaInscripcion": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Verificar estado del servidor",
        "description": "Comprueba si la API esta respondiendo correctamente.",
        "responses": {
          "200": {
            "description": "Servidor funcionando correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "timestamp": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Registro de usuarios",
        "description": "Registra un nuevo usuario en la base de datos.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nombre", "email", "password"],
                "properties": {
                  "nombre": { "type": "string", "minLength": 2, "maxLength": 100 },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 8, "maxLength": 72 },
                  "role": { "$ref": "#/components/schemas/Role" },
                  "sedeId": { "type": "string", "nullable": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario registrado exitosamente",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": {
            "description": "Datos de entrada invalidos",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Iniciar sesion",
        "description": "Autentica al usuario y genera un token JWT.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autenticacion exitosa",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string" },
                    "user": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciales invalidas",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Obtener datos del usuario autenticado",
        "description": "Retorna la informacion del perfil del usuario logueado en base al token JWT.",
        "security": [
          { "BearerAuth": [] }
        ],
        "responses": {
          "200": {
            "description": "Datos del perfil obtenidos",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": {
            "description": "No autorizado por falta o invalidez del token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/sedes": {
      "get": {
        "summary": "Listar sedes",
        "description": "Retorna un listado paginado de sedes registradas.",
        "security": [
          { "BearerAuth": [] }
        ],
        "parameters": [
          { "name": "ciudad", "in": "query", "schema": { "type": "string" }, "required": false },
          { "name": "estado", "in": "query", "schema": { "$ref": "#/components/schemas/EstadoSede" }, "required": false },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "required": false },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 }, "required": false }
        ],
        "responses": {
          "200": {
            "description": "Listado de sedes obtenido exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Sede" }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "total": { "type": "integer" },
                        "page": { "type": "integer" },
                        "limit": { "type": "integer" },
                        "totalPages": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Crear sede",
        "description": "Crea una nueva sede. Endpoint restringido para administradores.",
        "security": [
          { "BearerAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nombre", "ciudad", "direccion"],
                "properties": {
                  "nombre": { "type": "string", "minLength": 2 },
                  "ciudad": { "type": "string", "minLength": 2 },
                  "direccion": { "type": "string", "minLength": 5 },
                  "estado": { "$ref": "#/components/schemas/EstadoSede" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sede creada exitosamente",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Sede" }
              }
            }
          },
          "403": {
            "description": "Acceso denegado. Se requiere rol de ADMIN.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/sedes/{id}": {
      "get": {
        "summary": "Obtener sede por ID",
        "description": "Retorna los detalles de una sede especifica.",
        "security": [
          { "BearerAuth": [] }
        ],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Detalles de la sede obtenidos",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Sede" }
              }
            }
          },
          "404": {
            "description": "Sede no encontrada"
          }
        }
      },
      "put": {
        "summary": "Actualizar sede",
        "description": "Actualiza parcialmente una sede existente. Requiere rol de ADMIN.",
        "security": [
          { "BearerAuth": [] }
        ],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": { "type": "string" },
                  "ciudad": { "type": "string" },
                  "direccion": { "type": "string" },
                  "estado": { "$ref": "#/components/schemas/EstadoSede" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sede actualizada con exito",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Sede" }
              }
            }
          },
          "403": {
            "description": "No autorizado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Eliminar sede",
        "description": "Elimina una sede por su identificador. Requiere rol de ADMIN.",
        "security": [
          { "BearerAuth": [] }
        ],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Sede eliminada de forma exitosa",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Sede" }
              }
            }
          },
          "403": {
            "description": "Acceso restringido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/estudiantes": {
      "get": {
        "summary": "Listar estudiantes",
        "description": "Retorna un listado paginado de estudiantes. Los usuarios con rol OPERADOR obtendran exclusivamente estudiantes asociados a su sede.",
        "security": [
          { "BearerAuth": [] }
        ],
        "parameters": [
          { "name": "sedeId", "in": "query", "schema": { "type": "string" }, "required": false },
          { "name": "estado", "in": "query", "schema": { "$ref": "#/components/schemas/EstadoEstudiante" }, "required": false },
          { "name": "search", "in": "query", "schema": { "type": "string" }, "required": false },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "required": false },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 }, "required": false }
        ],
        "responses": {
          "200": {
            "description": "Listado de estudiantes recuperado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Estudiante" }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "total": { "type": "integer" },
                        "page": { "type": "integer" },
                        "limit": { "type": "integer" },
                        "totalPages": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Crear estudiante",
        "description": "Crea un nuevo estudiante asociado a una sede especifica.",
        "security": [
          { "BearerAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nombreCompleto", "email", "telefono", "documentoIdentidad", "sedeId", "programa"],
                "properties": {
                  "nombreCompleto": { "type": "string", "minLength": 2 },
                  "email": { "type": "string", "format": "email" },
                  "telefono": { "type": "string" },
                  "documentoIdentidad": { "type": "string" },
                  "sedeId": { "type": "string" },
                  "programa": { "type": "string" },
                  "estado": { "$ref": "#/components/schemas/EstadoEstudiante" },
                  "fechaInscripcion": { "type": "string", "format": "date-time" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Estudiante creado con exito",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Estudiante" }
              }
            }
          }
        }
      }
    },
    "/api/estudiantes/{id}": {
      "get": {
        "summary": "Obtener estudiante por ID",
        "description": "Obtiene la ficha de un estudiante especifico en base a su identificador.",
        "security": [
          { "BearerAuth": [] }
        ],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Datos del estudiante recuperados",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Estudiante" }
              }
            }
          },
          "404": {
            "description": "Estudiante no encontrado"
          }
        }
      },
      "put": {
        "summary": "Actualizar estudiante",
        "description": "Modifica de manera parcial los datos de un estudiante registrado.",
        "security": [
          { "BearerAuth": [] }
        ],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombreCompleto": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "telefono": { "type": "string" },
                  "documentoIdentidad": { "type": "string" },
                  "sedeId": { "type": "string" },
                  "programa": { "type": "string" },
                  "estado": { "$ref": "#/components/schemas/EstadoEstudiante" },
                  "fechaInscripcion": { "type": "string", "format": "date-time" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Estudiante modificado correctamente",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Estudiante" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Eliminar estudiante",
        "description": "Realiza un borrado logico del estudiante en el sistema.",
        "security": [
          { "BearerAuth": [] }
        ],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Estudiante eliminado exitosamente",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Estudiante" }
              }
            }
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "summary": "Obtener estadisticas generales",
        "description": "Retorna metricas agregadas por sede y estado. Si el usuario cuenta con el rol OPERADOR, las estadisticas estaran filtradas unicamente a la sede asignada.",
        "security": [
          { "BearerAuth": [] }
        ],
        "responses": {
          "200": {
            "description": "Estadisticas consolidadas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "totalPorSede": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "sedeId": { "type": "string" },
                          "nombreSede": { "type": "string" },
                          "total": { "type": "integer" }
                        }
                      }
                    },
                    "totalPorEstado": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "estado": { "type": "string" },
                          "total": { "type": "integer" }
                        }
                      }
                    },
                    "sedeConMasActivos": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "sedeId": { "type": "string" },
                        "nombreSede": { "type": "string" },
                        "totalActivos": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
