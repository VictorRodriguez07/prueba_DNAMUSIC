generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERADOR
}

enum EstadoSede {
  ACTIVA
  INACTIVA
}

enum EstadoEstudiante {
  ACTIVO
  INACTIVO
  RETIRADO
}

model User {
  id        String   @id @default(cuid())
  nombre    String
  email     String   @unique
  password  String
  role      Role     @default(OPERADOR)
  sedeId    String?
  sede      Sede?    @relation(fields: [sedeId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Sede {
  id          String     @id @default(cuid())
  nombre      String
  ciudad      String
  direccion   String
  estado      EstadoSede @default(ACTIVA)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  estudiantes Estudiante[]
  usuarios    User[]

  @@map("sedes")
}

model Estudiante {
  id                 String           @id @default(cuid())
  nombreCompleto     String
  email              String           @unique
  telefono           String
  documentoIdentidad String           @unique
  sedeId             String
  sede               Sede             @relation(fields: [sedeId], references: [id])
  programa           String
  estado             EstadoEstudiante @default(ACTIVO)
  fechaInscripcion   DateTime         @default(now())
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("estudiantes")
}